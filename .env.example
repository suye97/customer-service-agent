# DashScope / OpenAI compatible embeddings
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10
# Development only: deterministic vectors have no semantic search value.
EMBEDDING_MOCK=0

# Milvus
SYMBOL_AGENT_MILVUS_URI=http://<MILVUS_HOST>:19530
SYMBOL_AGENT_MILVUS_TOKEN=<MILVUS_TOKEN>
MILVUS_COLLECTION=agent_design_kb

# Shopping assistant answers (ingestion does not call the LLM).
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
